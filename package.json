{
  "name": "socrates-aprende",
  "private": true,
  "version": "0.2.0",
  "description": "Socrates Aprende — programas educativos de Sexto Primaria CNB Guatemala y AWS Certified Cloud Practitioner.",
  "type": "module",
  "scripts": {
    "cnb": "node scripts/build-cnb.mjs ../contenido",
    "plan": "node scripts/plan-year.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dev": "npm run icons && vite --host",
    "build": "npm run icons && npm run pwa:icons && npm run validate && tsc --noEmit && vite build && npm run pwa:inject",
    "pwa:icons": "node scripts/gen-pwa-icons.mjs",
    "pwa:inject": "node scripts/inject-pwa-assets.mjs",
    "preview": "vite preview --host",
    "validate": "node --import tsx scripts/validate-content.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mobile": "node --import tsx tests/mobile-learning.mjs && node tests/mobile-precision.mjs && node tests/mobile-stages.mjs && node --import tsx tests/mobile-navigation.mjs",
    "test:ui": "node tests/interface-theme.mjs && node --import tsx tests/interface-e2e.mjs",
    "build:standalone": "npm run icons && node scripts/build-standalone.mjs",
    "e2e": "npm run build:standalone && node tests/e2e.mjs",
    "publish:aws:dry-run": "node --import tsx scripts/publish-aws-course.ts",
    "publish:aws": "node --import tsx scripts/publish-aws-course.ts --publish"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": ">=0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0"
  }
}
